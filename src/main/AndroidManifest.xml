<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="io.github.ffdvdgd.opluskeymap.permission.RESET_TOUCHES"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.github.ffdvdgd.opluskeymap.permission.RESET_TOUCHES" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:name=".SettingsApp"
        android:label="@string/app_name"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:hasCode="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">
        <activity android:name=".SettingsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
        <activity android:name=".GameSelectionActivity" android:label="适用游戏" android:exported="false" />
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="io.github.ffdvdgd.opluskeymap.XposedService"
            android:exported="true"
            android:directBootAware="false" />
    </application>
</manifest>
